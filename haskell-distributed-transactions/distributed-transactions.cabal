cabal-version:      2.4
name:               distributed-transactions
version:            1.0.0.0
synopsis:           Purely functional Two-Phase Commit and STM Cross-Shard Settlements
description:        Formally models distributed transactions with ACID guarantees and atomicity.
license:            Apache-2.0
author:             Enterprise Systems
maintainer:         engineering@example.com
category:           Distributed Systems

executable distributed-transactions
    main-is:          Transactions.hs
    hs-source-dirs:   src
    default-language: Haskell2010
    build-depends:    base >= 4.14 && < 5,
                      stm >= 2.5,
                      containers >= 0.6
